# --- ENUMS ---
enum AccountType {
    SAVINGS
    CHECKING
}

enum TransactionType {
    DEPOSIT
    WITHDRAWAL
    TRANSFER
}

# --- TYPES ---
type Customer {
    id: ID!
    fullName: String!
    email: String!
    nationalId: String!
    accounts: [Account]
}

type Account {
    id: ID!
    accountNumber: String!
    accountType: AccountType!
    balance: Float!
    customer: Customer
    transactions: [Transaction]
}

type Transaction {
    id: ID!
    amount: Float!
    type: TransactionType!
    timestamp: String!
}

# --- INPUTS ---
input CustomerInput {
    fullName: String!
    email: String!
    nationalId: String!
}

input AccountInput {
    accountNumber: String!
    accountType: AccountType!
    customerId: ID!
}

# --- QUERIES ---
type Query {
    findAllCustomers: [Customer]
    findCustomerById(id: ID!): Customer
    findAccountByNumber(accountNumber: String!): Account
}

# --- MUTATIONS ---
type Mutation {
    createCustomer(input: CustomerInput!): Customer!
    createAccount(input: AccountInput!): Account!
    deposit(accountNumber: String!, amount: Float!): Account!
}